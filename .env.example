# ============================================================
#  Media stack secrets & settings  (~/mediastack/.env)
#  Keep this file private - never share or commit it.
# ============================================================

# ---------- 1) PASTE HERE: ProtonVPN WireGuard private key ----------
# account.protonvpn.com -> Downloads -> WireGuard configuration
#   Platform: Linux | VPN options: NAT-PMP (Port Forwarding) ON | Server: any P2P server
#   Open the downloaded .conf and copy ONLY the value after "PrivateKey = "
WIREGUARD_PRIVATE_KEY=CHANGE_ME

# ---------- 2) PASTE HERE: Real-Debrid API token ----------
# real-debrid.com/apitoken  -> copy the token shown
REAL_DEBRID_API_TOKEN=CHANGE_ME

# ---------- 3) CHECK: your timezone ----------
# System clock is set to UTC. Change to your zone if needed, e.g. Asia/Karachi, Europe/London
TZ=UTC

# ---------- Do not change below (filled in by Claude) ----------
PUID=1000
PGID=1000
UMASK=002
STACK_DIR=/home/zawar/mediastack
DATA_DIR=/data
LAN_SUBNET=10.0.0.0/24
INTEL_RENDER_NODE=/dev/dri/renderD128

# qBittorrent WebUI login (user: Zawar) - set by Claude
QBIT_USERNAME=CHANGE_ME
QBIT_PASSWORD=CHANGE_ME

# ---------- Lidify (music discovery for Lidarr) ----------
LIDARR_API_KEY=CHANGE_ME          # Lidarr -> Settings -> General -> API Key
LASTFM_API_KEY=CHANGE_ME          # https://www.last.fm/api/account/create
LASTFM_API_SECRET=CHANGE_ME

# ---------- slskd (Soulseek, runs inside the VPN) ----------
SLSK_USERNAME=CHANGE_ME           # Soulseek account (created on first login)
SLSK_PASSWORD=CHANGE_ME
SLSKD_WEB_USERNAME=CHANGE_ME      # slskd web page login
SLSKD_WEB_PASSWORD=CHANGE_ME
SLSKD_API_KEY=CHANGE_ME           # 16+ random characters; also pasted into DroppedNeedle
